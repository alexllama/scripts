#!/usr/bin/env bash
set -u

HOME_DIR="$HOME"
CONFIG="$HOME_DIR/.config/git-watch/config"
STATE="$HOME_DIR/.local/state/git-watch"
CACHE="$HOME_DIR/.cache/git-watch"
REPORT="$STATE/last-report.md"
LOG="$STATE/git-watch.log"
TS=$(date -Iseconds)
DATE_SHORT=$(date +%Y%m%d-%H%M%S)

# Check for JSON mode
JSON_MODE=0
if [[ "${1:-}" == "--json" || "${1:-}" == "json" ]]; then
  JSON_MODE=1
fi

# Ensure dirs exist
mkdir -p "$STATE" "$CACHE" "$HOME_DIR/.local/bin"

# Source env if exists (for SSH_AUTH_SOCK)
if [[ -f "$HOME_DIR/.config/git-watch/env" ]]; then
  # shellcheck disable=SC1091
  . "$HOME_DIR/.config/git-watch/env"
fi

# Trap to ensure we always write something
cleanup() {
  if [[ ! -f "$REPORT" ]]; then
    cat > "$REPORT" << EOF
# Git Watch Report (failed)
- Run: $TS

The git-watch script failed unexpectedly. Check $LOG for details.
EOF
  fi
}
trap cleanup EXIT

# Overwrite log for this run only (keep last night's entry as requested - we overwrite each run)
: > "$LOG"
log() {
  echo "[$(date -Iseconds)] $*" >> "$LOG"
}

log "Starting git-watch run"

# Function to classify protocol
get_proto() {
  local url="$1"
  if [[ -z "$url" ]]; then
    echo "none"
    return
  fi
  if [[ "$url" =~ ^git@ || "$url" =~ ^ssh:// ]]; then
    echo "ssh"
    return
  fi
  if [[ "$url" =~ ^https:// ]]; then
    echo "https"
    return
  fi
  echo "other"
}

# Collect repos
mapfile -t discovered < <(
  {
    # Find normal repos via fd (constrained to $HOME)
    if command -v fd >/dev/null 2>&1; then
      fd -H -t d -t f '^\.git$' "$HOME_DIR" \
        --exclude node_modules \
        --exclude .cache \
        --exclude .local/share/containers \
        --exclude .cargo/registry \
        --exclude .npm \
        --exclude snap \
        --exclude .var/app \
        2>/dev/null | while read -r gitpath; do
          [[ -z "$gitpath" ]] && continue
          if [[ -f "$gitpath" ]]; then
            dirname "$gitpath"
          else
            dirname "$gitpath"
          fi
        done
    else
      # Fallback to find if fd missing (shouldn't happen per requirements)
      find "$HOME_DIR" \
        \( -path "*/node_modules/*" -o -path "*/.cache/*" -o -path "*/.local/share/containers/*" -o -path "*/.cargo/*" -o -path "*/.npm/*" -o -path "*/snap/*" -o -path "*/.var/app/*" \) -prune -o \
        -name ".git" \( -type f -print -o -type d -print \) 2>/dev/null | while read -r gitpath; do
          [[ -z "$gitpath" ]] && continue
          if [[ -f "$gitpath" ]]; then
            dirname "$gitpath"
          else
            dirname "$gitpath"
          fi
        done
    fi

    # Add explicit bare entries from config
    if [[ -f "$CONFIG" ]]; then
      grep -v '^[[:space:]]*#' "$CONFIG" | grep -v '^[[:space:]]*$' | while IFS=: read -r type gdir wtree; do
        [[ "$type" == "bare" ]] || continue
        [[ -n "$gdir" ]] || continue
        # Expand $HOME if present
        gdir_exp="${gdir//\$HOME/$HOME_DIR}"
        wtree_exp="${wtree//\$HOME/$HOME_DIR}"
        if [[ -n "$wtree_exp" ]]; then
          echo "BARE|$gdir_exp|$wtree_exp"
        else
          echo "BARE|$gdir_exp|"
        fi
      done
    fi
  } | sort -u
)

# Build list of repos to check
repos_list=()
for entry in "${discovered[@]}"; do
  [[ -z "$entry" ]] && continue
  if [[ "$entry" == BARE\|* ]]; then
    IFS='|' read -r _type gdir wtree <<< "$entry"
    repos_list+=("BARE|$gdir|$wtree")
    continue
  fi
  # normal repo candidate
  repo_root="$entry"
  # Verify it's a git repo
  if git -C "$repo_root" rev-parse --git-dir >/dev/null 2>&1; then
    repos_list+=("NORMAL|$repo_root|")
  else
    log "Discovery verification failed for: $repo_root"
  fi
done

# Deduplicate while preserving order of first appearance
declare -A seen
unique_repos=()
for entry in "${repos_list[@]}"; do
  key="$entry"
  if [[ -z "${seen[$key]:-}" ]]; then
    seen[$key]=1
    unique_repos+=("$entry")
  fi
done

log "Discovered ${#unique_repos[@]} repo entries to check"

# Start building report header
{
  echo "# Git Watch Report"
  echo "- Run: $TS"
  echo "- Host: $(hostname)"
  echo "- User: $(whoami)"
  echo ""
} > "$REPORT"

summary_dirty=0
summary_behind=0
summary_errors=0
summary_repos=0

# Arrays to store results
declare -a dirty_repos=()
declare -a clean_repos=()
declare -a all_repo_data=()

# Function to run git with appropriate env
run_git() {
  local type="$1"
  shift
  local gdir="$1"
  shift
  local wtree="$1"
  shift
  if [[ "$type" == "BARE" ]]; then
    if [[ -n "$wtree" ]]; then
      env GIT_DIR="$gdir" GIT_WORK_TREE="$wtree" git "$@"
    else
      env GIT_DIR="$gdir" git "$@"
    fi
  else
    local repo_root="$gdir"
    git -C "$repo_root" "$@"
  fi
}

# Process each repo
for entry in "${unique_repos[@]}"; do
  IFS='|' read -r rtype gdir wtree <<< "$entry"
  summary_repos=$((summary_repos + 1))
  
  if [[ "$rtype" == "BARE" ]]; then
    display_path="$wtree"
    if [[ -z "$display_path" ]]; then
      display_path="$gdir"
    fi
  else
    display_path="$gdir"
  fi
  
  log "Checking: $display_path ($rtype)"
  
  errors_repo=()
  dirty_count=0
  ahead=0
  behind=0
  branch=""
  upstream=""
  proto="none"
  remote_url=""
  dirty_out=""
  
  # Get remote URL
  if remote_url=$(run_git "$rtype" "$gdir" "$wtree" remote get-url origin 2>&1); then
    proto=$(get_proto "$remote_url")
  else
    errors_repo+=("Failed to get origin remote: $remote_url")
    proto="none"
  fi
  
  # Get branch
  if branch=$(run_git "$rtype" "$gdir" "$wtree" rev-parse --abbrev-ref HEAD 2>&1); then
    : 
  else
    errors_repo+=("Failed to get branch: $branch")
    branch="unknown"
  fi
  
  # Check dirty status
  if dirty_out=$(run_git "$rtype" "$gdir" "$wtree" status --porcelain 2>&1); then
    if [[ -n "$dirty_out" ]]; then
      dirty_count=$(echo "$dirty_out" | grep -c '^' || true)
    else
      dirty_count=0
    fi
  else
    errors_repo+=("Failed to get status: $dirty_out")
    dirty_count=0
  fi
  
  # Fetch
  fetch_out=""
  fetch_rc=0
  if [[ "$rtype" == "BARE" ]]; then
    if [[ -n "$wtree" ]]; then
      fetch_out=$(timeout 300 bash -c 'GIT_DIR="$1" GIT_WORK_TREE="$2" git fetch --quiet --all' _ "$gdir" "$wtree" 2>&1)
      fetch_rc=$?
    else
      fetch_out=$(timeout 300 bash -c 'GIT_DIR="$1" git fetch --quiet --all' _ "$gdir" 2>&1)
      fetch_rc=$?
    fi
  else
    fetch_out=$(timeout 300 git -C "$gdir" fetch --quiet --all 2>&1)
    fetch_rc=$?
  fi
  if [[ $fetch_rc -eq 0 ]]; then
    : 
  else
    if [[ $fetch_rc -eq 124 ]]; then
      errors_repo+=("Fetch timed out after 300s")
      log "TIMEOUT fetching $display_path"
    else
      errors_repo+=("Fetch failed (rc=$fetch_rc): $fetch_out")
      log "FETCH ERROR for $display_path: $fetch_out"
      # Check for common SSH issues
      if echo "$fetch_out" | grep -qi "Permission denied\|publickey\|Host key verification"; then
        errors_repo+=("SSH/auth error suspected - check SSH_AUTH_SOCK/agent/passphrase")
      fi
    fi
  fi
  
  # Check upstream
  if [[ $fetch_rc -eq 0 || -n "$(run_git "$rtype" "$gdir" "$wtree" rev-parse --abbrev-ref '@{u}' 2>/dev/null)" ]]; then
    if upstream=$(run_git "$rtype" "$gdir" "$wtree" rev-parse --abbrev-ref '@{u}' 2>&1); then
      if [[ "$upstream" != "@{u}" && -n "$upstream" ]]; then
        # Calculate ahead/behind
        if behind=$(run_git "$rtype" "$gdir" "$wtree" rev-list --count HEAD.."$upstream" 2>&1); then
          if [[ "$behind" =~ ^[0-9]+$ ]]; then
            : 
          else
            behind=0
            errors_repo+=("Failed to calculate behind count")
          fi
        else
          behind=0
          errors_repo+=("Failed to calculate behind: $behind")
        fi
        
        if ahead=$(run_git "$rtype" "$gdir" "$wtree" rev-list --count "$upstream"..HEAD 2>&1); then
          if [[ "$ahead" =~ ^[0-9]+$ ]]; then
            : 
          else
            ahead=0
            errors_repo+=("Failed to calculate ahead count")
          fi
        else
          ahead=0
          errors_repo+=("Failed to calculate ahead: $ahead")
        fi
      else
        upstream="none"
        ahead=0
        behind=0
      fi
    else
      upstream="none"
      errors_repo+=("No upstream configured or failed to get upstream: $upstream")
    fi
  else
    upstream="unknown (fetch failed)"
  fi
  
  # Update summaries
  if [[ $dirty_count -gt 0 ]]; then
    summary_dirty=$((summary_dirty + dirty_count))
  fi
  if [[ $behind -gt 0 ]]; then
    summary_behind=$((summary_behind + behind))
  fi
  if [[ ${#errors_repo[@]} -gt 0 ]]; then
    summary_errors=$((summary_errors + 1))
  fi
  
  error_flag="no"
  if [[ ${#errors_repo[@]} -gt 0 ]]; then
    error_flag="YES"
  fi
  
  # Store result for later sorting
  errors_str=$(printf '%s;' "${errors_repo[@]}")
  dirty_b64=$(printf '%s' "$dirty_out" | base64 -w0 2>/dev/null || printf '%s' "$dirty_out" | base64 | tr -d '\n')
  all_repo_data+=("$display_path|$rtype|$gdir|$wtree|$proto|$branch|$upstream|$dirty_count|$ahead|$behind|$error_flag|$remote_url|$errors_str|$dirty_b64")
  
  if [[ $dirty_count -gt 0 || $behind -gt 0 || ${#errors_repo[@]} -gt 0 ]]; then
    dirty_repos+=("$display_path|$rtype|$proto|$branch|$upstream|$dirty_count|$ahead|$behind|$error_flag|$gdir|$wtree|$remote_url|$dirty_out")
  else
    clean_repos+=("$display_path|$rtype|$proto|$branch|$upstream|$dirty_count|$ahead|$behind|$error_flag|$gdir|$wtree|$remote_url|")
  fi
  
done

if [[ $JSON_MODE -eq 1 ]]; then
  python3 - "$summary_repos" "$summary_dirty" "$summary_behind" "$summary_errors" "$TS" "$LOG" "${all_repo_data[@]}" << 'PYEOF'
import sys
import json
import base64

args = sys.argv[1:]
summary_repos = int(args[0])
summary_dirty = int(args[1])
summary_behind = int(args[2])
summary_errors = int(args[3])
ts = args[4]
log_path = args[5]
repo_args = args[6:]

repos = []
for entry in repo_args:
    parts = entry.split('|')
    if len(parts) < 14:
        continue
    display_path = parts[0]
    rtype = parts[1]
    gdir = parts[2]
    wtree = parts[3]
    proto = parts[4]
    branch = parts[5]
    upstream = parts[6]
    dirty_count = int(parts[7])
    ahead = int(parts[8])
    behind = int(parts[9])
    error_flag = parts[10]
    remote_url = parts[11]
    errors_str = parts[12].rstrip(';')
    dirty_b64 = parts[13]
    try:
        dirty_out = base64.b64decode(dirty_b64).decode('utf-8', errors='replace')
    except Exception:
        dirty_out = ''
    errors = [e for e in errors_str.split(';') if e]
    repos.append({
        'path': display_path,
        'type': rtype,
        'gitdir': gdir,
        'worktree': wtree,
        'protocol': proto,
        'branch': branch,
        'upstream': upstream,
        'dirty': dirty_count,
        'ahead': ahead,
        'behind': behind,
        'errors': error_flag == 'YES',
        'error_messages': errors,
        'remote': remote_url,
        'dirty_files': dirty_out.splitlines() if dirty_out else []
    })

result = {
    'timestamp': ts,
    'summary': {
        'repos_checked': summary_repos,
        'dirty_files': summary_dirty,
        'behind_commits': summary_behind,
        'repos_with_errors': summary_errors
    },
    'repos': repos
}
print(json.dumps(result, indent=2))
PYEOF
  exit 0
fi

# Write report with dirty repos first (using column for aligned tables)
{
  echo "## Needs Attention (Dirty / Behind / Errors)"
  echo ""
  if [[ ${#dirty_repos[@]} -eq 0 ]]; then
    echo "_None_"
    echo ""
  else
    {
      echo "REPO|TYPE|PROTO|BRANCH|UPSTREAM|DIRTY|AHEAD/BEHIND|ERRORS"
      for entry in "${dirty_repos[@]}"; do
        IFS='|' read -r dpath drtype dproto dbranch dupstream ddirty dahead dbehind derrorflag dgdir dwtree dremote ddout <<< "$entry"
        echo "${dpath}|${drtype}|${dproto}|${dbranch}|${dupstream}|${ddirty}|+${dahead}/-${dbehind}|${derrorflag}"
      done
    } | column -t -s '|' 
    echo ""
    echo "### Details"
    for entry in "${dirty_repos[@]}"; do
      IFS='|' read -r dpath drtype dproto dbranch dupstream ddirty dahead dbehind derrorflag dgdir dwtree dremote ddout <<< "$entry"
      echo ""
      echo "#### $dpath"
      echo "- Type: $drtype"
      echo "- Git dir: $dgdir"
      [[ -n "$dwtree" ]] && echo "- Worktree: $dwtree"
      echo "- Protocol: $dproto"
      [[ -n "$dremote" && "$dremote" != "error:"* && "$dremote" != "Failed"* ]] && echo "- Remote origin: $dremote"
      echo "- Branch: $dbranch"
      echo "- Upstream: $dupstream"
      echo "- Dirty files: $ddirty"
      echo "- Ahead/Behind: +$dahead / -$dbehind"
      echo "- Errors: $derrorflag"
      echo ""
      if [[ $ddirty -gt 0 && -n "$ddout" ]]; then
        echo "##### Uncommitted changes"
        echo '```'
        echo "$ddout"
        echo '```'
        echo ""
      fi
    done
  fi
  
  echo ""
  echo "## Clean (No Action Needed)"
  echo ""
  if [[ ${#clean_repos[@]} -eq 0 ]]; then
    echo "_None_"
    echo ""
  else
    {
      echo "REPO|TYPE|PROTO|BRANCH|UPSTREAM|DIRTY|AHEAD/BEHIND|ERRORS"
      for entry in "${clean_repos[@]}"; do
        IFS='|' read -r cpath crtype cproto cbranch cupstream cdirty cahead cbehind cerrorflag cgdir cwtree cremote ccdout <<< "$entry"
        echo "${cpath}|${crtype}|${cproto}|${cbranch}|${cupstream}|${cdirty}|+${cahead}/-${cbehind}|${cerrorflag}"
      done
    } | column -t -s '|' 
    echo ""
  fi
  
  echo ""
  echo "## Totals"
  echo "- Repos checked: $summary_repos"
  echo "- Repos needing attention: ${#dirty_repos[@]}"
  echo "- Clean repos: ${#clean_repos[@]}"
  echo "- Total dirty files: $summary_dirty"
  echo "- Total commits behind: $summary_behind"
  echo "- Repos with errors: $summary_errors"
  echo ""
  echo "---"
  echo "Full log: $LOG"
} >> "$REPORT"

# Add summary footer
{
  echo ""
  echo "## Totals"
  echo "- Repos checked: $summary_repos"
  echo "- Total dirty files: $summary_dirty"
  echo "- Total commits behind: $summary_behind"
  echo "- Repos with errors: $summary_errors"
  echo ""
  echo "---"
  echo "Full log: $LOG"
} >> "$REPORT"

log "Completed. Repos: $summary_repos, dirty: $summary_dirty, behind: $summary_behind, errors: $summary_errors"

trap - EXIT

# Send notification with summary (concise, link to full report)
notify_msg="Git Watch: ${summary_repos} repos | ${summary_dirty} dirty | ${summary_behind} behind | ${summary_errors} errors. Report: $REPORT"
if command -v notify-send >/dev/null 2>&1; then
  (setsid notify-send -u critical -t 0 -i dialog-information "Git Watch" "$notify_msg" >/dev/null 2>&1 &) 
  disown 2>/dev/null || true
  exit 0
fi
exit 0

exit 0
